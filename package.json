{
  "name": "@local/openviking-viewer",
  "version": "0.1.0",
  "type": "module",
  "description": "Browse the OpenViking memory behind the DeepSeek Harness memory plugin from the Web UI: memories, resources, skills, search, and connection status.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "author": "Leonard-Data",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leonard-Data/openviking-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/Leonard-Data/openviking-viewer/issues"
  },
  "homepage": "https://github.com/Leonard-Data/openviking-viewer#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "openviking",
    "memory",
    "plugin",
    "web-ui"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "node --check index.js && node --check client.js",
    "test": "node --test \"test/*.test.mjs\"",
    "build": "npm pack --dry-run",
    "check:version": "node .github/scripts/check-version.mjs",
    "check:files": "node .github/scripts/check-files.mjs"
  }
}
